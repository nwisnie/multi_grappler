# Set these in your server environment; this file is not loaded automatically.
PORT=9080
HOST=0.0.0.0
# Comma-separated browser origins allowed to connect (recommended for deployment).
ALLOWED_ORIGINS=https://your-game.example
# Optional Cloudflare TURN settings. Never put these in project.godot or browser JS.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
TURN_TTL_SECONDS=86400
# Alternative to Cloudflare credential generation:
# ICE_SERVERS_JSON=[{"urls":["stun:stun.cloudflare.com:3478"]},{"urls":["turn:your-turn.example:3478"],"username":"temporary-user","credential":"temporary-password"}]
