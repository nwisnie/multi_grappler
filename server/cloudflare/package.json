{
  "name": "multi-grappler-cloudflare-signaling",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev --ip 127.0.0.1 --port 9080 --infer-origin-from-routes=false",
    "deploy": "wrangler deploy",
    "check": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "db:local": "wrangler d1 migrations apply multi-grappler-levels --local",
    "db:remote": "wrangler d1 migrations apply multi-grappler-levels --remote",
    "test": "node --test test/*.test.js"
  },
  "devDependencies": {
    "miniflare": "5.20261023.1-beta",
    "wrangler": "4.154.0"
  }
}
