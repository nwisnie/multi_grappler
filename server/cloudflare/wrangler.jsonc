{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "multi-grappler-rooms",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  },
  "routes": [
    { "pattern": "rooms.wizkinews.com", "custom_domain": true }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "GameRoom" },
      { "name": "LOBBIES", "class_name": "LobbyDirectory" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["LobbyDirectory"] }
  ],
  "d1_databases": [
    {
      "binding": "LEVELS_DB",
      "database_name": "multi-grappler-levels",
      // Add database_id from `wrangler d1 create multi-grappler-levels` before deploying.
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://wizkinews.com,https://www.wizkinews.com,http://localhost:8000,http://127.0.0.1:8000",
    "TURN_TTL_SECONDS": "86400",
    "ROOM_TTL_SECONDS": "43200"
  },
  // Anonymous players share these counters when behind the same public IP.
  "ratelimits": [
    { "name": "CREATE_LIMITER", "namespace_id": "271001", "simple": { "limit": 20, "period": 60 } },
    { "name": "CONNECT_LIMITER", "namespace_id": "271002", "simple": { "limit": 120, "period": 60 } },
    { "name": "UPLOAD_LIMITER", "namespace_id": "271003", "simple": { "limit": 5, "period": 60 } },
    { "name": "AUTH_LIMITER", "namespace_id": "271004", "simple": { "limit": 20, "period": 60 } },
    { "name": "REGISTER_LIMITER", "namespace_id": "271005", "simple": { "limit": 5, "period": 60 } }
  ],
  "limits": { "cpu_ms": 1000 }
}
