{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "multi-grappler-rooms",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-27",
  "workers_dev": true,
  "routes": [
    { "pattern": "rooms.wizkinews.com", "custom_domain": true }
  ],
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "GameRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom"] }],
  "vars": {
    "ALLOWED_ORIGINS": "https://wizkinews.com,https://www.wizkinews.com,http://localhost:8000,http://127.0.0.1:8000",
    "TURN_TTL_SECONDS": "86400",
    "ROOM_TTL_SECONDS": "43200"
  },
  // Anonymous players share these counters when behind the same public IP.
  "ratelimits": [
    { "name": "CREATE_LIMITER", "namespace_id": "271001", "simple": { "limit": 20, "period": 60 } },
    { "name": "CONNECT_LIMITER", "namespace_id": "271002", "simple": { "limit": 120, "period": 60 } }
  ],
  "limits": { "cpu_ms": 50 }
}
